{
  "name": "secretaria-cururu",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Automação e Conciliação de Contas Domésticas (100% Free Tier)",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:backend": "pnpm --filter @secretaria/backend dev",
    "dev:frontend": "pnpm --filter @secretaria/frontend dev",
    "worker:reconcile": "pnpm --filter @secretaria/worker reconcile"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
